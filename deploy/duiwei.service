[Unit]
Description=duiwei (jd-screener) docker compose wrapper
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ubuntu/zxLumen-Blog/docker
ExecStart=/usr/bin/docker compose up -d duiwei
ExecReload=/usr/bin/docker compose restart duiwei
ExecStop=/usr/bin/docker compose stop duiwei
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
