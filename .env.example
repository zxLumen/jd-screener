# 对位 · 本地/容器环境变量（复制为 .env 或用 env 注入）
PORT=8790

# AI 网关（OpenAI 兼容）；不配 token 就自动规则模式
ZX_AI_GATEWAY_URL=http://localhost:3000/api/ai/v1
ZX_AI_APP_TOKEN=
# 可选：留空由网关按令牌/密钥决定
JD_MODEL=

# 限流（每 IP 每小时）
JD_AI_RATE=20
JD_AI_DAILY=500
JD_TOTAL_RATE=240
# 搜索会抓外部站点，单独限额（每 IP 每小时 / 全站每天）
JD_SEARCH_RATE=30
JD_SEARCH_DAILY=300
# 简历解析（每 IP 每小时）
JD_RESUME_RATE=20
