# 对位 · 本地/容器环境变量（复制为 .env 或用 env 注入）
PORT=8790

# AI 网关（OpenAI 兼容）；不配 token 就自动规则模式
ZX_AI_GATEWAY_URL=http://localhost:3000/api/ai/v1
ZX_AI_APP_TOKEN=
# 可选：留空由网关按令牌/密钥决定
JD_MODEL=

# 限流（每 IP 每小时）
JD_AI_RATE=20
JD_AI_DAILY=500
JD_TOTAL_RATE=240
# 搜索会抓外部站点，单独限额（每 IP 每小时 / 全站每天）
JD_SEARCH_RATE=30
JD_SEARCH_DAILY=300
# 简历解析（每 IP 每小时）
JD_RESUME_RATE=20

# 来源登录管理令牌：不设置则 /api/admin/sources 与网页「来源登录」关闭
# 生成：openssl rand -hex 24
JD_ADMIN_TOKEN=
# 可选：用环境变量注入 cookie（重启生效；网页保存的优先）
# BOSS_COOKIE=
# BOSS_UA=
# MAIMAI_COOKIE=

# 可选：大陆出口。留空 = 不启用出口（搜索行为与 0.2.3 一致）
# 家里 SSH 反向隧道：socks5h://127.0.0.1:1080
# Docker 容器：unix:/run/jd-exit/bridge.sock（需配 jd-exit-bridge.service）
JD_EXIT_PROXY=
# 出口探测硬超时（毫秒，最大 2000）
JD_EXIT_TIMEOUT_MS=2000
